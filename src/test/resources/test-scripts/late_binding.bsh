#!/bin/java bsh.Interpreter

source("TestHarness.bsh");
source("Assert.bsh");

/** Methods resolve free variables where they were declared, not in the caller's scope (#906) */
int bar = 42;
int getBar() { return bar; }
{
   {
      int bar = 4711;
      {
         int bar = 5;
         assertEquals("Method sees its declared value from a nested block", 42, getBar());
      }
      assertEquals("Method sees its declared value from an outer block", 42, getBar());
   }
   assertEquals("Method sees its declared value from the outermost block", 42, getBar());
}
assertEquals("Method sees its declared value at its declaring scope", 42, getBar());

complete();
