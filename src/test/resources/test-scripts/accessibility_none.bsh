#!/bin/java bsh.Interpreter

source("TestHarness.bsh");
source("Assert.bsh");

import mypackage.*;

a=new Accessibility2();

// Without accessibility. Kept apart from accessibility.bsh, which is skipped
// altogether when the build runs without it, so these checks always run.

setAccessibility(false);

assert( Fields.propTest == 22 );
assert(Accessibility2.sfield4==4);

/*
    package mypackage;
    class A { public static field; }
    public class B extends A { }

    Should 'field' of non-public A be accessible through public class B?
    javac would allow this, but reflection API only works with accessibility on
*/
assert(isEvalError("No static field or inner class: supersfield4 of class mypackage.Accessibility2", 'Accessibility2.supersfield4==4'));

javax.swing.JInternalFrame.DO_NOTHING_ON_CLOSE;

// Method doest not exist
assert( isEvalError("a.get1()") );
// Method is private
assert( isEvalError("a.getB1()") );
// Method is package protected
assert( isEvalError("a.getB2()") );
// Field is private
assert( isEvalError("No such field: field1", "a.field1") );
// Field is package protected
assert( isEvalError("No such field: field2", "a.field2") );


complete();
