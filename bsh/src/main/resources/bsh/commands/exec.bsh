/**
    Start an external application and print its output with print(), including
    anything the application writes to its standard error.

    The single String form splits the command on whitespace and does not
    honour quoting, so pass an argument that contains spaces with the
    String[] form instead.

    @return the exit status of the application
*/

bsh.help.exec = "usage: exec( String command | String [] command )";

int exec( String command )
{
    return exec( command.trim().split("\\s+") );
}

int exec( String [] command )
{
    this.process = new ProcessBuilder( command )
        .redirectErrorStream( true )
        .start();
    this.output = new BufferedReader(
        new InputStreamReader( this.process.getInputStream() ) );
    while ( (line = this.output.readLine()) != null )
        print( line );
    return this.process.waitFor();
}
